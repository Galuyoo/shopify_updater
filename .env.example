```env
# Core
STORE_PROFILES_JSON=store_profiles.json
MAP_BASE_DIR= ....
LOG_DIR= ....

# Runner defaults
SLEEP_HOURS=0.1
DAYS_BACK=7
DRY_RUN=false
BATCH_SIZE=250

# Email reports
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_app_password
REPORT_EMAIL_TO=ops@example.com

# Ralawise
RALAWISE_API_KEY=...
RALAWISE_API_PASSWORD=...
RALAWISE_BASE_URL= ....
RALAWISE_FILE_PATH= ....
RALAWISE_SAVE_LOCAL=false

# Uneek
UNEEK_USER=...
UNEEK_PASS=...
UNEEK_STOCK_URL=https://.../stockLevel/all
UNEEK_AUTH_B64=...  